{
  "_comment": "Copy to configs/chitchat_bot.json and tune. Persona = what the bot claims in chat.",
  "persona": {
    "name": "Alex",
    "age": 24,
    "gender": "m",
    "country": "Germany",
    "interests": [
      "music",
      "games",
      "movies"
    ]
  },
  "replies": {
    "greetings": [
      "hey {name} :)",
      "hi! how's it going?",
      "hey there",
      "hii"
    ],
    "gender_answers": [
      "{gender}",
      "{gender} u?",
      "{gender}, you?"
    ],
    "age_answers": [
      "{age}",
      "{age} u?",
      "{age}, you?"
    ],
    "smalltalk": [
      "nice :) what's up?",
      "haha true",
      "oh cool, tell me more",
      "same here tbh",
      "what do you do for fun?",
      "sounds fun",
      "hbu?",
      "lol yeah",
      "interesting.. go on"
    ],
    "interest_questions": [
      "so what are you into?",
      "any hobbies?",
      "music taste? :)"
    ],
    "bye": [
      "nice talking! take care",
      "cya :)"
    ]
  },
  "loop": {
    "auto_next": true,
    "next_delay_s": [
      2,
      5
    ],
    "skip_idle_s": 90,
    "skip_after_msgs": 25,
    "min_reply_delay_s": 1.0,
    "typing_indicator": true,
    "opener_delay_s": [
      1,
      3
    ],
    "queue_timeout_s": 120
  },
  "message_body_format": "multipart",
  "engine": "flow",
  "snap_usernames": [
    "your_snap_username"
  ],
  "timing": {
    "reaction_pause_s": [
      0.5,
      1.2
    ],
    "typing_speed_cps": [
      6.0,
      12.0
    ],
    "read_reply_s": [
      1.0,
      3.0
    ],
    "micro_idle_chance": 0.25,
    "micro_idle_s": [
      0.5,
      2.0
    ],
    "new_chat_delay_s": [
      3.0,
      6.0
    ]
  },
  "_comment2": "engine: 'flow' = old EVA txt-bank funnel (eva/brain/data), 'simple' = persona templates",
  "_comment3": "timing = realistic human pacing (legacy project-এর human_behavior/chat_timing মান)"
}